-- ANIMATION
local function openUI()
	frame.Visible = true
	frame.Position = UDim2.new(0.5, -160, 0.5, 20)
	TweenService:Create(frame, TweenInfo.new(0.22, Enum.EasingStyle.Quad), {
		Position = UDim2.new(0.5, -160, 0.5, -210)
	}):Play()
	toggleBtn.Text = "Close"
end

local function closeUI()
	local tween = TweenService:Create(frame, TweenInfo.new(0.18), {
		Position = UDim2.new(0.5, -160, 0.5, 20)
	})
	tween:Play()
	tween.Completed:Connect(function()
		frame.Visible = false
	end)
	toggleBtn.Text = "Open"
end

toggleBtn.MouseButton1Click:Connect(function()
	if frame.Visible then
		closeUI()
	else
		openUI()
	end
end)

-- BUTTON ACTIONS
cauBtn.MouseButton1Click:Connect(function()
	remoteEvent:FireServer("BuyRune", "CAU_RUNE")
end)

addBtn.MouseButton1Click:Connect(function()
	remoteEvent:FireServer("BuyRune", "ADD_RUNE")
end)

gpaBtn.MouseButton1Click:Connect(function()
	remoteEvent:FireServer("BuyRune", "GPA_RUNE")
end)

-- UPDATE UI
local function updateUI(data)
	cauLabel.Text = "CAU Coins: " .. math.floor(data.coins or 0)
	addLabel.Text = "ADD Points: " .. math.floor(data.add or 0)
	gpaLabel.Text = "GPA Score: " .. math.floor(data.gpa or 0)

	local cauMult = 2^(data.cauRunes or 0)
	local addMult = 2^(data.addRunes or 0)
	local gpaMult = 2^(data.gpaRunes or 0)

	cauRuneLabel.Text = string.format("CAU Runes: %d (+%d)", data.cauRunes or 0, cauMult)
	addRuneLabel.Text = string.format("ADD Runes: %d (+%d)", data.addRunes or 0, addMult)
	gpaRuneLabel.Text = string.format("GPA Runes: %d (+%d)", data.gpaRunes or 0, gpaMult)

	cauBtn.Text = string.format("Buy CAU Rune (%d)", data.cauCost or 10)
	addBtn.Text = string.format("Buy ADD Rune (%d)", data.addCost or 100)
	gpaBtn.Text = string.format("Buy GPA Rune (%d ADD)", data.gpaCost or 100)
end

remoteEvent.OnClientEvent:Connect(updateUI)

