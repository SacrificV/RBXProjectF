local function makeLabel(yOffset, text)
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, 0, 0, 26)
	lbl.Position = UDim2.new(0, 0, 0, yOffset)
	lbl.BackgroundTransparency = 1
	lbl.TextColor3 = Color3.fromRGB(235, 235, 245)
	lbl.Font = Enum.Font.GothamMedium
	lbl.TextSize = 18
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Text = text
	lbl.Parent = frame
	return lbl
end

local function makeButton(text, yOffset)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 40)
	btn.Position = UDim2.new(0, 0, 0, yOffset)
	btn.BackgroundColor3 = Color3.fromRGB(55, 55, 70)
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 16
	btn.Text = text
	btn.AutoButtonColor = false
	btn.Parent = frame

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 12)
	c.Parent = btn

	local s = Instance.new("UIStroke")
	s.Thickness = 1
	s.Color = Color3.fromRGB(120, 120, 145)
	s.Transparency = 0.45
	s.Parent = btn

	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(70, 70, 90)}):Play()
	end)

	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(55, 55, 70)}):Play()
	end)

	return btn
end

local cauLabel = makeLabel(50, "CAU Coins: 0")
local addLabel = makeLabel(80, "ADD Points: 0")
local gpaLabel = makeLabel(110, "GPA Score: 0")
local cauRuneLabel = makeLabel(150, "CAU Runes: 0 (x1)")
local addRuneLabel = makeLabel(180, "ADD Runes: 0 (x1)")
local gpaRuneLabel = makeLabel(210, "GPA Runes: 0 (x1)")

local cauBtn = makeButton("Buy CAU Rune (10)", 255)
local addBtn = makeButton("Buy ADD Rune (100)", 300)
local gpaBtn = makeButton("Buy GPA Rune (100 ADD)", 345)

